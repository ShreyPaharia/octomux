{
  "name": "octomux",
  "version": "1.4.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShreyPaharia/octomux.git"
  },
  "bin": {
    "octomux": "./bin/octomux"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin/octomux",
    "bin/cli-wrapper.cjs",
    "bin/platform.cjs",
    "scripts/install-binary.cjs",
    "scripts/postinstall.sh",
    "plugin/",
    "templates/",
    "workflows/",
    "kinds/"
  ],
  "workspaces": [
    "packages/api-client",
    "packages/capabilities",
    "packages/diff-engine",
    "packages/types",
    "packages/test-fixtures"
  ],
  "scripts": {
    "dev": "concurrently \"bun:dev:server\" \"bun:dev:client\"",
    "dev:server": "bun --watch server/index.ts",
    "dev:client": "vite",
    "build": "bun run build:diff-engine && bun run build:types && bun run build:test-fixtures && bun run build:api-client && bun run build:capabilities && bun run build:binary",
    "build:diff-engine": "tsc -b packages/diff-engine",
    "build:types": "tsc -b packages/types",
    "build:test-fixtures": "tsc -b packages/test-fixtures",
    "build:api-client": "tsc -b packages/api-client",
    "start": "bun run bin/main.js start",
    "test": "bun run test:server && bun run test:client && bun run test:units",
    "bench:task-create": "NODE_ENV=test tsx scripts/bench-task-create.ts",
    "test:watch": "NODE_ENV=test bun test ./server --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:mobile-terminal": "playwright test e2e/mobile-terminal-scroll.spec.ts",
    "test:mobile-terminal:watch": "playwright test e2e/mobile-terminal-scroll.spec.ts --ui",
    "screenshots:docs": "tsx scripts/seed-docs-demo.ts && OCTOMUX_SCREENSHOTS=1 OCTOMUX_DB_PATH=./data/docs-demo/tasks.db playwright test e2e/docs-screenshots.spec.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "prepublishOnly": "bun run build:npm",
    "postinstall": "node scripts/install-binary.cjs && bash scripts/postinstall.sh",
    "prepare": "husky",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s",
    "build:electron": "tsc -p electron/tsconfig.json",
    "dist:electron": "bun run build && bun run build:electron && electron-builder",
    "build:capabilities": "tsc -b packages/capabilities",
    "test:server": "NODE_ENV=test bun test ./server ./cli/review --parallel --timeout 15000",
    "test:client": "NODE_ENV=test bun test ./src --preload ./src/bun-test-setup.ts --parallel --timeout 15000",
    "test:units": "NODE_ENV=test bun test ./cli/src ./packages ./bin --parallel --timeout 30000",
    "build:assets": "bun scripts/bundle-assets.mjs",
    "build:binary": "vite build && bun run build:assets && bun build --compile --minify bin/main.js --outfile dist-bin/octomux",
    "build:binary:all": "vite build && bun run build:assets && bun build --compile --minify --target=bun-darwin-arm64 bin/main.js --outfile dist-bin/octomux-darwin-arm64 && bun build --compile --minify --target=bun-darwin-x64 bin/main.js --outfile dist-bin/octomux-darwin-x64 && bun build --compile --minify --target=bun-linux-arm64 bin/main.js --outfile dist-bin/octomux-linux-arm64 && bun build --compile --minify --target=bun-linux-x64 bin/main.js --outfile dist-bin/octomux-linux-x64 && bun build --compile --minify --target=bun-linux-arm64-musl bin/main.js --outfile dist-bin/octomux-linux-arm64-musl && bun build --compile --minify --target=bun-linux-x64-musl bin/main.js --outfile dist-bin/octomux-linux-x64-musl",
    "build:npm": "bun run build:binary:all && bun run sign:macos && bun scripts/build-npm-packages.mjs",
    "sign:macos": "bash scripts/sign-macos.sh"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "trustedDependencies": [
    "husky"
  ],
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@linear/sdk": "^88.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@monaco-editor/react": "^4.7.0",
    "@octomux/api-client": "workspace:*",
    "@octomux/diff-engine": "workspace:*",
    "@octomux/test-fixtures": "workspace:*",
    "@octomux/types": "workspace:*",
    "@slack/socket-mode": "^3.0.0",
    "@slack/web-api": "^8.0.0",
    "@xterm/addon-webgl": "0.18.0",
    "ajv": "^8.20.0",
    "chalk": "^5.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^14.0.3",
    "compression": "^1.8.1",
    "croner": "^10.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.0.1",
    "fix-path": "^4.0.0",
    "grammy": "^1.45.1",
    "js-yaml": "^4.2.0",
    "monaco-editor": "^0.55.1",
    "nanoid": "^5.0.9",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "latest",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "@octomux/tmux-darwin-arm64": "1.0.34",
    "@octomux/tmux-darwin-x64": "1.0.34",
    "@octomux/tmux-linux-x64": "1.0.34",
    "@octomux/tmux-linux-arm64": "1.0.34"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@electron/rebuild": "^3.0.0",
    "@eslint/js": "^9.0.0",
    "@happy-dom/global-registrator": "^20.11.2",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "bun-types": "^1.3.14",
    "concurrently": "^9.1.0",
    "conventional-changelog-cli": "^5.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^16.0.0",
    "prettier": "^3.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0",
    "react-router-dom": "^7.0.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0"
  }
}
